// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  role              String    // "seller", "buyer", "admin"
  name              String
  email             String    @unique
  phone             String?
  address           String?
  passwordHash      String?
  logo              String?   // Logo or avatar image URL
  bankName          String?   // Vietnamese bank name (e.g. Vietcombank, Techcombank, MB Bank)
  bankAccountNumber String?   // Seller domestic bank account number
  bankAccountName   String?   // Account holder name (e.g. NGUYEN VAN A)
  vietQrImage       String?   // Uploaded VietQR code image URL
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  products          Product[] @relation("SellerProducts")
  orders            Order[]   @relation("BuyerOrders")
}

model Product {
  id          String      @id @default(uuid())
  sellerId    String
  seller      User        @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String      @default("General")
  basePrice   Float       // Base price in VND
  weight      Float       @default(0.5) // Product weight in kg (used by shipper to calculate shipping cost)
  inventory   Int         @default(0)
  images      String      // Store images as JSON array string: '["url1", "url2"]'
  status      String      @default("active") // "active", "draft", "out_of_stock"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Fee {
  id            String    @id @default(uuid())
  feeName       String    @unique // "shipping" (VND per kg), "packaging" (VND per unit)
  amount        Float     // fee amount in VND
  effectiveDate DateTime  @default(now())
}

model Order {
  id                    String      @id @default(uuid())
  buyerId               String
  buyer                 User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  totalPaid             Float       // Total paid by buyer in USD
  status                String      @default("Ready for Pickup") // "Ready for Pickup", "Driver Assigned", "Picked Up", "In Packaging", "Shipped", "Delivered"
  paymentStatus         String      @default("paid") // "pending", "paid", "failed"
  payoutStatus          String      @default("unpaid") // "unpaid", "paid_by_hub"
  payoutMethod          String?     // "VietQR Napas 247", "Cash on Pickup (COD)", "Weekly Bank Batch"
  payoutRef             String?     // Bank / VietQR transaction reference ID
  payoutAt              DateTime?   // Timestamp when Saigon Hub transferred funds to merchant
  stripeSessionId       String?
  stripePaymentIntentId String?
  deliveryName          String?
  deliveryAddress       String?
  deliveryPhone         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
}

model OrderItem {
  id                       String  @id @default(uuid())
  orderId                  String
  order                    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                String
  product                  Product @relation(fields: [productId], references: [id])
  quantity                 Int
  weightAtPurchase         Float   @default(0.5) // Unit weight in kg at time of purchase
  sellerPriceAtPurchase    Float
  shippingFeeAtPurchase    Float
  packagingFeeAtPurchase   Float
}
